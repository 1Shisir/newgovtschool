{
  "entities": {
    "SiteContent": {
      "title": "Site Content",
      "description": "Global content for the school website",
      "type": "object",
      "properties": {
        "hero": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "subtitle": { "type": "string" },
            "motto": { "type": "string" },
            "backgroundImage": { "type": "string" }
          }
        },
        "about": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "subtitle": { "type": "string" },
            "description": { "type": "string" },
            "principalMessage": { "type": "string" },
            "principalName": { "type": "string" },
            "principalRole": { "type": "string" },
            "principalImage": { "type": "string" },
            "sideImage": { "type": "string" }
          }
        },
        "footer": {
          "type": "object",
          "properties": {
            "address": { "type": "string" },
            "phone": { "type": "string" },
            "email": { "type": "string" },
            "mapImage": { "type": "string" }
          }
        }
      }
    },
    "Notice": {
      "title": "Notice",
      "description": "A school notice or announcement",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["Event", "Admissions", "Academic", "Holiday"] }
      },
      "required": ["date", "title", "description", "type"]
    },
    "AcademicSubject": {
      "title": "Academic Subject",
      "description": "A subject or class in the academics section",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "color": { "type": "string" }
      },
      "required": ["title", "description", "icon", "color"]
    },
    "GalleryImage": {
      "title": "Gallery Image",
      "description": "An image in the school gallery",
      "type": "object",
      "properties": {
        "src": { "type": "string" },
        "alt": { "type": "string" },
        "span": { "type": "string", "enum": ["row-span-1", "row-span-2"] }
      },
      "required": ["src", "alt", "span"]
    },
    "User": {
      "title": "User",
      "description": "A user of the system",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] }
      },
      "required": ["uid", "email", "role"]
    }
  },
  "firestore": {
    "/config/site": {
      "schema": "SiteContent",
      "description": "Global site configuration"
    },
    "/notices/{noticeId}": {
      "schema": "Notice",
      "description": "Collection of notices"
    },
    "/academics/{subjectId}": {
      "schema": "AcademicSubject",
      "description": "Collection of academic subjects"
    },
    "/gallery/{imageId}": {
      "schema": "GalleryImage",
      "description": "Collection of gallery images"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    }
  }
}
